def dragAndDrop():
	if session:
		args = request.args.to_dict()
		return render_template('home/dragAndDrop.html', message=args["message"] if len(request.args) > 0 else False)
	
	else:

		return redirect(url_for('loginForm'))

def allowed_file(filename):
    return '.' in filename and \
           filename.rsplit('.', 1)[1] in ALLOWED_EXTENSIONS

def uploadFile():

	if session and session['id']:

		if request.method == 'POST':
			
			file = request.files['file']

			filename = secure_filename(file.filename)
			
			if file and allowed_file(filename):

				filename = secure_filename(filename)
				file.save(os.path.join(UPLOAD_FOLDER, filename))

				fileType = filename.rsplit('.', 1)[1]

				establisments = User.get_establishments_of_user(session['id'])

				if fileType == 'csv':

					config = SparkConf().setAppName("Alfadatizando");
					sqlContext = SQLContext(SparkContext())
					sqlContext.setConf("spark.jars", (os.path.join("resources","postgresql-42.3.0.jar")))
					sqlContext.setConf("spark.jars.ivy","/tmp/.ivy")
					sqlContext.setConf("ivy.home","/tmp")
					sqlContext.setConf("ivy.cache.dir","/tmp")
					sqlContext.setConf("spark.jars", (os.path.join("resources","postgresql-42.3.0.jar")))
					sqlContext.setLogLevel("INFO")

					firstRow = sqlContext.read.format("csv").option("encoding", "UTF-8").load(os.path.join(UPLOAD_FOLDER,filename)).limit(2).first()

					return render_template('home/uploadConfiguration.html', firstRow = firstRow, filename=filename, establisments=establisments)

				else:

					if fileType == 'json':

						return render_template('home/uploadConfigurationJSON.html', filename=filename, establisments=establisments)

					else: 
						flash('Debe subir un archivo de tipo CSV o JSON', 'danger')

						return render_template('home/dragAndDrop.html')

		else:

			flash('Error en el enviado del formulario', 'danger')

			return render_template('home/dragAndDrop.html')

	else:

		flash('Debe estar logueado para usar esta funcion.', 'danger')

		return render_template('home/dragAndDrop.html')		


